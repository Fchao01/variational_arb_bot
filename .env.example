# Lighter RH (Robinhood Chain) API credentials — 复制为 .env 并填入真实值
# RH 与 Lighter Core 主网是独立部署：账户、API key、市场 ID 和资金不互通。
# 本项目固定连接 https://api.rh.lighter.xyz，RH 账户必须在这里创建。

LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_PRIVATE_KEY=

# 可选：在 Lighter WS 新旧逻辑切换期间临时强制旧逻辑
# LIGHTER_WS_SERVER_PINGS=true
